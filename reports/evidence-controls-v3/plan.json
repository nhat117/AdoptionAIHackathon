  "hypotheses": {
    "section_5b": "Under Danger, non-witness correct action is higher with authenticated capsules than with content-matched unverified capsules; unverified is compared with text-only to separate content from authentication",
    "section_6": "Authenticated truth first usable in round three follows a round-two decision exposed to the false source claim for active neighbors; measure later action changes under Danger and irreversible exits under Safe, relative to the same-prompt no-evidence control",
    "unit": "Whole game; seeds are the replication unit",
    "inference": "Descriptive with exact permutation test over seeds"
  }
