ADAPTION_API_KEY=
BRAINTRUST_API_KEY=

# LangGraph Studio (separate from your Adaption API key)
LANGSMITH_API_KEY=
# APAC region; use the matching endpoint if your account is in another region.
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_TRACING=false

# Studio is offline by default. Set live only to make real Adaption calls.
SWARM_LAB_MODE=offline
SWARM_LAB_CONFIG=examples/playground.json
